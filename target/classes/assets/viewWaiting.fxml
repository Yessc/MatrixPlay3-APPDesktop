<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchor" minHeight="600.0" minWidth="600.0"
            style="-fx-background-color: #1e1e1e;"
            xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.client.ConfigWaiting">

    <Label fx:id="waitingLabel" text="Waiting" textFill="#ffffff"
           layoutX="250" layoutY="100" style="-fx-font-size: 20px;"/>

    <HBox spacing="50" alignment="CENTER" layoutY="250" layoutX="100">

        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <ImageView fx:id="player1Image" fitHeight="100" fitWidth="100"/>
            <Label fx:id="player1Name" text="" textFill="#ffffff"/>
        </VBox>

        <Label text="VS" textFill="#ffffff" style="-fx-font-size: 24px;"/>

        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <ImageView fx:id="player2Image" fitHeight="100" fitWidth="100"/>
            <Label fx:id="p" text="..." textFill="#ffffff"/>
        </VBox>

    </HBox>

</AnchorPane>
